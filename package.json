{
  "name": "canvas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Сервис совместных холстов",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#controllers/*": {
      "production": "./build/controllers/*",
      "default": "./src/controllers/*"
    },
    "#middlewares/*": {
      "production": "./build/middlewares/*",
      "default": "./src/middlewares/*"
    },
    "#models/*": {
      "production": "./build/models/*",
      "default": "./src/models/*"
    },
    "#repositories/*": {
      "production": "./build/repositories/*",
      "default": "./src/repositories/*"
    },
    "#routers/*": {
      "production": "./build/routers/*",
      "default": "./src/routers/*"
    },
    "#scripts/*": {
      "production": "./build/scripts/*",
      "default": "./src/scripts/*"
    },
    "#services/*": {
      "production": "./build/services/*",
      "default": "./src/services/*"
    },
    "#utilities/*": {
      "production": "./build/utilities/*",
      "default": "./src/utilities/*"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf ./build && tsc",
    "start": "node --conditions=production ./build/index.js",
    "lint": "eslint ./src --ext ts --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write ./src ./tools",
    "token": "tsx tools/issue-token.ts",
    "bench:actions": "tsx tools/bench-actions.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "sequelize": "6.37.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/pg": "8.18.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-love": "43.1.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "tsx": "4.21.0",
    "typescript": "5.3.3"
  }
}
